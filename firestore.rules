rules_version = '2';

// Reglas de seguridad: cada cuenta solo puede leer y cambiar SU tienda
// (tiendas/{su-id} y todo lo que está adentro). Nadie más puede verla.
service cloud.firestore {
  match /databases/{database}/documents {
    match /tiendas/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{documento=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
